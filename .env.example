# Copy to `.env` (never commit it) and `set -a; source .env; set +a` before running the IQM
# hardware-submission scripts with USE_HARDWARE=1. Without these variables every hardware
# script falls back to a local simulator (IQM fake backends / Aer) and prints a notice.

# IQM Resonance (Garnet / Emerald) — 04_quantum_qaoa
IQM_TOKEN=
IQM_SERVER_URL=          # e.g. the Resonance URL of the target device

# Optional: run from a different location
# PROGERIA_DEPOSIT=/path/to/HGPS_meta_QAOA
